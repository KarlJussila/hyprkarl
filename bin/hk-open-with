#!/usr/bin/env python3
"""Open the shell app chooser or perform one of its Gio-owned actions."""

import json
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gio", "2.0")
gi.require_version("GioUnix", "2.0")
from gi.repository import Gio, GioUnix


def icon_name(app: Gio.AppInfo) -> str:
    icon = app.get_icon()
    return icon.to_string() if icon is not None else "application-x-executable"


def chooser_apps(default_id: str) -> list[Gio.AppInfo]:
    return sorted(
        (
            app
            for app in Gio.AppInfo.get_all()
            if app.get_id() and (app.should_show() or app.get_id() == default_id)
        ),
        key=lambda app: (app.get_display_name() or app.get_name()).casefold(),
    )


def file_content_type(path: Path) -> str:
    info = Gio.File.new_for_path(str(path)).query_info(
        "standard::content-type", Gio.FileQueryInfoFlags.NONE, None
    )
    return info.get_content_type()


def print_entries(path: Path) -> None:
    content_type = file_content_type(path)
    default_app = Gio.AppInfo.get_default_for_type(content_type, False)
    default_id = default_app.get_id() if default_app is not None else ""
    entries = []

    for app in chooser_apps(default_id):
        name = app.get_display_name() or app.get_name()
        generic_name = app.get_generic_name() or ""
        app_id = app.get_id() or ""
        entries.append(
            {
                "id": app_id,
                "name": name,
                "genericName": generic_name,
                "icon": icon_name(app),
                "keywords": app.get_keywords(),
                "categories": list(filter(None, (app.get_categories() or "").split(";"))),
                "executable": Path(app.get_executable() or "").name,
                "isDefault": app_id == default_id,
            }
        )

    json.dump(
        {"mimeType": content_type, "entries": entries},
        sys.stdout,
        ensure_ascii=False,
        separators=(",", ":"),
    )
    print()


def launch(path: Path, app_id: str, make_default: bool) -> None:
    app = GioUnix.DesktopAppInfo.new(app_id)
    if app is None:
        raise RuntimeError(f"Application not found: {app_id}")

    if make_default:
        content_type = file_content_type(path)
        if not app.set_as_default_for_type(content_type):
            raise RuntimeError(f"Could not set {app_id} as the default for {content_type}")

    app.launch([Gio.File.new_for_path(str(path))], None)


def usage() -> None:
    print(
        "Usage:\n"
        "  hk-open-with <file>\n"
        "  hk-open-with entries <file>\n"
        "  hk-open-with launch <file> <desktop-id> <true|false>",
        file=sys.stderr,
    )


def main() -> int:
    try:
        if len(sys.argv) == 2:
            subprocess.run(
                ["hk-shell", "open-with", "open", str(Path(sys.argv[1]).resolve())],
                check=True,
            )
            return 0

        if len(sys.argv) == 3 and sys.argv[1] == "entries":
            print_entries(Path(sys.argv[2]))
            return 0

        if len(sys.argv) == 5 and sys.argv[1] == "launch":
            launch(Path(sys.argv[2]), sys.argv[3], sys.argv[4] == "true")
            return 0
    except Exception as error:
        print(f"Open-with failed: {error}", file=sys.stderr)
        return 1

    usage()
    return 1


if __name__ == "__main__":
    raise SystemExit(main())

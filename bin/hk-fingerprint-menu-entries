#!/usr/bin/env python3
"""Print setup-aware fingerprint actions for dynamic Quickshell menus."""

from __future__ import annotations

import json
import sys

from lib.fingerprint import (
    FINGERPRINT_NAMES,
    enrolled_fingers,
    fingerprint_is_setup,
    fingerprint_label,
)


def root_entries() -> list[dict]:
    if not fingerprint_is_setup():
        return [
            {
                "id": "fingerprint.setup",
                "icon": "󰈷",
                "label": "Setup",
                "action": {
                    "type": "command",
                    "command": "hk-tui-launch hk-fingerprint setup",
                },
            }
        ]
    return [
        {
            "id": "fingerprint.enroll",
            "icon": "󰈷",
            "label": "Add Fingerprint",
            "action": {"type": "menu", "menu": "fingerprint-enroll"},
        },
        {
            "id": "fingerprint.remove",
            "icon": "",
            "label": "Remove Fingerprint",
            "action": {"type": "menu", "menu": "fingerprint-remove"},
        },
        {
            "id": "fingerprint.uninstall",
            "icon": "󱧖",
            "label": "Uninstall",
            "action": {
                "type": "command",
                "command": "hk-tui-launch hk-fingerprint setup --remove",
            },
        },
    ]


def finger_entries(mode: str) -> list[dict]:
    enrolled = enrolled_fingers()
    enrolled_set = set(enrolled)
    candidates = (
        [finger for finger in FINGERPRINT_NAMES if finger not in enrolled_set]
        if mode == "enroll"
        else enrolled
    )
    return [
        {
            "id": f"fingerprint-{mode}.{finger}",
            "label": fingerprint_label(finger),
            "action": {
                "type": "command",
                "command": f"hk-tui-launch hk-fingerprint {mode} {finger}",
            },
        }
        for finger in candidates
    ]


def main() -> int:
    invalid_mode = len(sys.argv) == 2 and sys.argv[1] not in {
        "root",
        "enroll",
        "remove",
    }
    if len(sys.argv) > 2 or invalid_mode:
        print(
            "Usage: hk-fingerprint-menu-entries [root|enroll|remove]", file=sys.stderr
        )
        return 1

    mode = sys.argv[1] if len(sys.argv) == 2 else "root"
    try:
        entries = root_entries() if mode == "root" else finger_entries(mode)
    except (OSError, RuntimeError) as error:
        print(error, file=sys.stderr)
        return 1

    json.dump(entries, sys.stdout, ensure_ascii=False, separators=(",", ":"))
    print()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

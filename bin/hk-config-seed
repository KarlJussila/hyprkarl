#!/bin/bash
# hk-config-seed
# Create the files Hyprkarl places in ~/.config once instead of linking.
#
# templates/config/ mirrors ~/.config and holds the personal files that
# linked configs include. Each is created when missing and never replaced.
#
# templates/starter/<app>/ is a complete starting config for an application
# that cannot load Hyprkarl's defaults next to a file of yours: btop rewrites
# its own config, and Neovim and Yazi configs are personal code. It is copied
# only when none of its files exist, so an existing setup is never mixed with
# Hyprkarl's files. Deleting every file of it brings it back on the next update.

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
TEMPLATES="$HYPRKARL_PATH/templates"

exists() {
  [[ -e "$1" ]] || [[ -L "$1" ]]
}

# Copy $2, relative to the template root $1, to the same path in ~/.config.
place() {
  mkdir -p "$(dirname "$CONFIG_HOME/$2")" || return 1
  cp -a "$1/$2" "$CONFIG_HOME/$2"
}

for app in "$TEMPLATES"/starter/*/; do
  app=$(basename "$app")
  mapfile -t files < <(cd "$TEMPLATES/starter" && find "$app" \( -type f -o -type l \))
  for relative in "${files[@]}"; do
    if exists "$CONFIG_HOME/$relative"; then
      continue 2
    fi
  done
  for relative in "${files[@]}"; do
    place "$TEMPLATES/starter" "$relative" || exit 1
  done
  printf 'Created starting config for %s\n' "$app"
done

mapfile -t files < <(cd "$TEMPLATES/config" && find . \( -type f -o -type l \) -printf '%P\n')
for relative in "${files[@]}"; do
  if exists "$CONFIG_HOME/$relative"; then
    continue
  fi
  place "$TEMPLATES/config" "$relative" || exit 1
  printf 'Created %s\n' "$CONFIG_HOME/$relative"
done

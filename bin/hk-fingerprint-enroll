#!/usr/bin/env python3
"""Enroll a specific fingerprint selected by the Quickshell menu."""

from __future__ import annotations

import os
import shutil
import subprocess
import sys

from lib.fingerprint import (
    FINGERPRINT_NAMES,
    fingerprint_is_setup,
    fingerprint_label,
)

GREEN = "\033[0;32m"
RED = "\033[0;31m"
YELLOW = "\033[1;33m"
NC = "\033[0m"


def print_color(color: str, message: str) -> None:
    print(f"{color}{message}{NC}")


def finish_with_error(message: str) -> int:
    print_color(RED, message)
    print_color(YELLOW, "Run 'hk-fingerprint setup' first.")
    subprocess.run(["hk-show-done"], check=False)
    return 1


def main() -> int:
    if len(sys.argv) != 2:
        print("Usage: hk-fingerprint enroll <finger-name>", file=sys.stderr)
        return 1
    if shutil.which("fprintd-enroll") is None:
        return finish_with_error("fprintd is not installed.")
    if not fingerprint_is_setup():
        return finish_with_error("Fingerprint authentication is not configured.")

    finger = sys.argv[1]
    if finger not in FINGERPRINT_NAMES:
        print_color(RED, f"Invalid finger name: {finger}")
        print_color(YELLOW, f"Valid names: {' '.join(FINGERPRINT_NAMES)}")
        subprocess.run(["hk-show-done"], check=False)
        return 1

    display_name = fingerprint_label(finger)
    user = os.environ["USER"]
    print_color(GREEN, f"\nEnrolling {display_name}...")
    print_color(YELLOW, "Keep moving your finger on the sensor until complete.\n")

    enrolled = (
        subprocess.run(["fprintd-enroll", "-f", finger, user], check=False).returncode
        == 0
    )
    if enrolled:
        print_color(GREEN, f"\n{display_name} enrolled successfully!")
        print_color(YELLOW, "\nVerifying...\n")
        verified = (
            subprocess.run(
                ["fprintd-verify", "-f", finger, user], check=False
            ).returncode
            == 0
        )
        if verified:
            print_color(GREEN, f"\n{display_name} verified!")
        else:
            print_color(RED, "\nVerification failed. Try enrolling again.")
    else:
        print_color(RED, f"\nEnrollment failed for {display_name}.")

    subprocess.run(["hk-show-done"], check=False)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env python3
"""Print installed theme actions for a dynamic Quickshell menu."""

from __future__ import annotations

import json
import os
import shlex
import sys
from pathlib import Path


def main() -> int:
    hyprkarl_path = Path(os.environ["HYPRKARL_PATH"])
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    roots = (hyprkarl_path / "themes", config_home / "hyprkarl" / "themes")

    themes = sorted(
        {
            path.name
            for root in roots
            if root.is_dir()
            for path in root.iterdir()
            if (path / "theme.yaml").is_file()
        }
    )
    entries = [
        {
            "id": f"theme.{theme}",
            "label": theme.replace("-", " ").title(),
            "action": {
                "type": "command",
                "command": f"hk-theme set {shlex.quote(theme)}",
            },
        }
        for theme in themes
    ]
    json.dump(entries, sys.stdout, ensure_ascii=False, separators=(",", ":"))
    print()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

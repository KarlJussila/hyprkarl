#!/bin/bash
# hk-shell-osd
# Show transient shell status through the public OSD IPC target.

SHELL_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell"

case "${1:-}" in
  volume) exec qs -p "$SHELL_CONFIG" ipc call osd volume "$2" "${3:-false}" ;;
  audio-output) exec qs -p "$SHELL_CONFIG" ipc call osd output "$2" "$3" "$4" ;;
  microphone) exec qs -p "$SHELL_CONFIG" ipc call osd microphone "$2" ;;
  display-brightness) exec qs -p "$SHELL_CONFIG" ipc call osd display "$2" ;;
  keyboard-brightness) exec qs -p "$SHELL_CONFIG" ipc call osd keyboard "$2" ;;
  media) exec qs -p "$SHELL_CONFIG" ipc call osd media "$2" "$3" "$4" "${5:-}" ;;
  *) exec qs -p "$SHELL_CONFIG" ipc call osd "$@" ;;
esac

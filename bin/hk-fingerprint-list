#!/usr/bin/env python3
"""List enrolled fingerprints, one finger name per line."""

from __future__ import annotations

import sys

from lib.fingerprint import enrolled_fingers


def main() -> int:
    try:
        print(*enrolled_fingers(), sep="\n")
    except Exception as error:  # noqa: BLE001 - public external-service boundary
        print(f"Could not list enrolled fingerprints: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

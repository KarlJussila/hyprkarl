{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "\n\n\n$1  🮏𜷥████𜷤\n  ▒██ ▒██\n ███𜵰 ▒██ 🮏𜷥███\n      ▒██ ▒██\n      🮎𜶫████𜵰\n\n$2░██ ░██ ░██ ░██\n░██▀▀██ ░██▀▀▄▄\n\n",
    "color": {
      "1": "{{fastfetch.logo.mark}}",
      "2": "{{fastfetch.logo.wordmark}}"
    }
  },
  "display": {
    "color": {
      "keys": "{{fastfetch.labels}}",
      "title": "{{fastfetch.title}}"
    }
  },
  "modules": {{fastfetch.modules | tojson}}
}

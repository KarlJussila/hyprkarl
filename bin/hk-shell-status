#!/bin/bash
# hk-shell-status
# Print JSON describing Hyprkarl Quickshell instances.

source "$HYPRKARL_PATH/bin/lib/shell.sh"

if ! instances=$(hk_shell_instances); then
  printf '{"running":false,"instances":[]}\n'
  exit 1
fi

jq '{
  running: true,
  instances: map({
    id,
    pid,
    launchTime: .launch_time
  })
}' <<<"$instances"

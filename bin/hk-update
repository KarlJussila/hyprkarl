#!/bin/bash
# hk-update
# Review and apply Hyprkarl source, configuration, package, and system changes.

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/lib/update.sh"

usage() {
  cat <<'EOF'
Usage:
  hk-update all           Review source, then apply every update category
  hk-update sync          Fetch and stage one reviewed source revision
  hk-update apply         Apply the reviewed source and shipped configuration
  hk-update packages      Review removals and install new required packages
  hk-update system        Run pending one-time system migrations
  hk-update check         Report pending work without changing anything
  hk-update remove-stale  Remove broken links into this checkout
EOF
}

action=${1:-}
shift || true

case "$action" in
  all)
    if [[ $# -gt 0 ]]; then
      usage >&2
      exit 1
    fi
    hk-update-sync || exit 1
    hk-update-apply || exit 1
    hk-update-packages || exit 1
    hk-update-system || exit 1
    if ! hk-hook-run post-update; then
      printf 'Update completed, but a post-update hook failed.\n' >&2
      exit 1
    fi
    ;;
  sync|apply|packages|system|check|remove-stale)
    exec "hk-update-$action" "$@" ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac

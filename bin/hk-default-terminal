#!/bin/bash
# hk-default-terminal
# Install a terminal emulator and make it the default for xdg-terminal-exec,
# which Hyprkarl opens every terminal through.
#
# Usage:
#   hk-default-terminal <alacritty|ghostty|kitty|foot>

case "$1" in
  alacritty) desktop_id="Alacritty.desktop" ;;
  ghostty) desktop_id="com.mitchellh.ghostty.desktop" ;;
  kitty) desktop_id="kitty.desktop" ;;
  foot) desktop_id="foot.desktop" ;;
  *)
    echo "Usage: hk-default-terminal [alacritty|ghostty|kitty|foot]" >&2
    exit 1
    ;;
esac

hk-pkg install "$1" || { echo "Failed to install $1" >&2; exit 1; }

# Ghostty opens windows faster with its background service running.
if [[ "$1" == "ghostty" ]]; then
  systemctl enable --user app-com.mitchellh.ghostty.service
else
  systemctl disable --user app-com.mitchellh.ghostty.service 2>/dev/null
fi

# A personal list replaces Hyprkarl's default one.
printf '%s\n' "$desktop_id" > "${XDG_CONFIG_HOME:-$HOME/.config}/xdg-terminals.list"

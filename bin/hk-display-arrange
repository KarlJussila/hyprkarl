#!/usr/bin/env python3
"""Arrange and rotate active displays."""

import json
import sys

from lib.display import arrange


def main() -> int:
    if len(sys.argv) != 2:
        print("Usage: hk-display-arrange <arrangement-json>", file=sys.stderr)
        return 1
    try:
        arrangement = json.loads(sys.argv[1])
        if not isinstance(arrangement, dict):
            raise RuntimeError("Arrangement must be a JSON object")
        json.dump(arrange(arrangement), sys.stdout, separators=(",", ":"))
        print()
        return 0
    except Exception as error:
        print(f"Could not arrange displays: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())

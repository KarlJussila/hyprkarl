#!/bin/bash
# hk-shell-start
# Start the Hyprkarl Quickshell bar if it is not running.

source "$HYPRKARL_PATH/bin/lib/shell.sh"

SHELL_UNIT="hyprkarl-quickshell.service"

if hk_shell_is_running; then
  echo "Shell is already running."
  exit 0
fi

if ! uwsm app -t service -u "$SHELL_UNIT" -d "Hyprkarl Quickshell" -- \
    env QML_IMPORT_PATH="$HK_SHELL_CONFIG" qs -p "$HK_SHELL_CONFIG"; then
  exit 1
fi

for _ in {1..100}; do
  if hk_shell_is_running; then
    echo "Shell started."
    exit 0
  fi

  if ! systemctl --user is-active --quiet "$SHELL_UNIT"; then
    break
  fi

  sleep 0.05
done

journalctl --user -u "$SHELL_UNIT" --since "5 seconds ago" --no-pager -o cat >&2
exit 1

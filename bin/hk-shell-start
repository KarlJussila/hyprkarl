#!/bin/bash
# hk-shell-start
# Start the Hyprkarl Quickshell bar if it is not running.

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/shell.sh
source "$SCRIPT_DIR/lib/shell.sh"

if hk_shell_is_running; then
  echo "Shell is already running."
  exit 0
fi

shell_import_path=$HK_SHELL_CONFIG
if [[ -n ${QML_IMPORT_PATH:-} ]]; then
  shell_import_path="$shell_import_path:$QML_IMPORT_PATH"
fi
launch_output="$(uwsm app -- env QML_IMPORT_PATH="$shell_import_path" \
  qs -d -p "$HK_SHELL_CONFIG" 2>&1)"

# Daemonized qs exits successfully even when loading the QML configuration fails.
if ! hk_shell_is_running; then
  if [[ -n "$launch_output" ]]; then
    printf '%s\n' "$launch_output" >&2
  else
    echo "Shell failed to start." >&2
  fi
  exit 1
fi

echo "Shell started."

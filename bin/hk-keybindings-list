#!/usr/bin/env python3
"""Print formatted live Hyprland keybindings."""

from __future__ import annotations

import sys

from lib.keybindings import keybinding_labels


def main() -> int:
    try:
        print(*keybinding_labels(), sep="\n")
    except (RuntimeError, TypeError) as error:
        print(error, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

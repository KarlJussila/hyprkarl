#!/bin/bash
# hk-shell-stop
# Stop every running instance of the Hyprkarl Quickshell configuration.

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/shell.sh
source "$SCRIPT_DIR/lib/shell.sh"

instances="$(hk_shell_instances)"
if [[ -z "$instances" ]]; then
  echo "Shell is already stopped."
  exit 0
fi

while read -r instance_id; do
  qs kill -i "$instance_id" >/dev/null || exit 1
done < <(jq -r '.[].id' <<<"$instances")

for _ in {1..40}; do
  if ! hk_shell_is_running; then
    echo "Shell stopped."
    exit 0
  fi

  sleep 0.05
done

echo "Shell failed to stop." >&2
exit 1

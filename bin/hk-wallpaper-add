#!/bin/bash
# hk-wallpaper-add
# Add a wallpaper to the current theme.
#
# Usage:
#   hk-wallpaper-add <path>
#
#   path   Path to the image file. Supported formats: jpg, jpeg, png, webp

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/lib/theme.sh"

THEME_NAME=$(theme_current_name)
USER_THEME_DIR="$HYPRKARL_USER_THEMES/$THEME_NAME"

source_path="$1"

if [[ -z "$source_path" ]]; then
  echo "Usage: hk-wallpaper-add <path>" >&2
  exit 1
fi

if [[ ! -f "$source_path" ]]; then
  echo "File not found: $source_path" >&2
  exit 1
fi

wallpaper_name=$(basename "$source_path")

if ! echo "$wallpaper_name" | grep -qiE '\.(jpg|jpeg|png|webp)$'; then
  echo "Unsupported file type: $wallpaper_name" >&2
  echo "Supported formats: jpg, jpeg, png, webp" >&2
  exit 1
fi

mkdir -p "$USER_THEME_DIR/wallpapers"
cp -L "$source_path" "$USER_THEME_DIR/wallpapers/$wallpaper_name"

if [[ -f "$USER_THEME_DIR/.wallpapers-disabled" ]]; then
  grep -Fxv "$wallpaper_name" "$USER_THEME_DIR/.wallpapers-disabled" \
    > "$USER_THEME_DIR/.wallpapers-disabled.next"
  mv "$USER_THEME_DIR/.wallpapers-disabled.next" "$USER_THEME_DIR/.wallpapers-disabled"
fi

exec 9> "$HYPRKARL_THEME_LOCK"
flock 9
theme_activate_bundle "$THEME_NAME" || exit 1
flock -u 9

hk-wallpaper-cache --single "$wallpaper_name"
hk-wallpaper-set "$wallpaper_name"

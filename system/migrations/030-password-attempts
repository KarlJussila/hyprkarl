#!/bin/bash
# Allow ten password attempts for sudo and Hyprlock authentication.

printf 'Defaults passwd_tries=10\n' | sudo tee /etc/sudoers.d/passwd-tries >/dev/null || exit 1
sudo chmod 440 /etc/sudoers.d/passwd-tries || exit 1
sudo sed -i -E 's/^#?[[:space:]]*deny[[:space:]]*=.*/deny = 10/' /etc/security/faillock.conf

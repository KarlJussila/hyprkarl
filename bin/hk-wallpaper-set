#!/bin/bash
# hk-wallpaper-set
# Set the current wallpaper.
#
# Usage:
#   hk-wallpaper-set <filename>

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/lib/theme.sh"

WALLPAPER_DIR="$HYPRKARL_CURRENT_THEME/wallpapers"
CURRENT_WALLPAPER_LINK="$HYPRKARL_CURRENT_WALLPAPER"

wallpaper_name="$1"

if [[ -z "$wallpaper_name" ]]; then
  echo "Usage: hk-wallpaper-set <filename>" >&2
  exit 1
fi
if [[ "$wallpaper_name" != "$(basename "$wallpaper_name")" ]]; then
  echo "Invalid wallpaper name: $wallpaper_name" >&2
  exit 1
fi

wallpaper_path="$WALLPAPER_DIR/$wallpaper_name"

if [[ ! -f "$wallpaper_path" ]]; then
  echo "Wallpaper not found: $wallpaper_path" >&2
  exit 1
fi

ln -nsf "theme/wallpapers/$wallpaper_name" "$CURRENT_WALLPAPER_LINK"
hyprctl hyprpaper wallpaper ",$wallpaper_path" || exit 1

if ! hk-hook-run wallpaper-set; then
  printf "Wallpaper '%s' was applied, but a wallpaper-set hook failed.\n" "$wallpaper_name" >&2
  exit 1
fi

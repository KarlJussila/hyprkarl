#!/bin/bash
# hk-shell-stop
# Stop every running instance of the Hyprkarl Quickshell configuration.

SHELL_UNIT="hyprkarl-quickshell.service"

if ! systemctl --user is-active --quiet "$SHELL_UNIT"; then
  echo "Shell is already stopped."
  exit 0
fi

systemctl --user stop "$SHELL_UNIT"
echo "Shell stopped."

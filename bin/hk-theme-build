#!/bin/bash
# hk-theme-build
# Build a typed theme source into a user-owned Hyprkarl theme bundle.
#
# Usage:
#   hk-theme-build <theme-source> [theme-name]

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/lib/theme.sh"

theme_source="${1:-}"
theme_name="${2:-}"
generator_path="${HYPRKARL_THEME_GENERATOR_PATH:-$HYPRKARL_PATH/../theme-generator}"

if [[ -z "$theme_source" ]]; then
  echo "Usage: hk-theme-build <theme-source> [theme-name]" >&2
  exit 1
fi
if [[ ! -d "$generator_path/theme_generator" ]]; then
  printf 'Theme generator not found: %s\n' "$generator_path" >&2
  exit 1
fi

if [[ -e "$theme_source" ]]; then
  theme_source=$(realpath "$theme_source")
fi
if [[ -z "$theme_name" ]]; then
  if [[ "$theme_source" == */theme.yaml ]]; then
    theme_name=$(basename "$(dirname "$theme_source")")
  else
    theme_name=$(basename "$theme_source")
  fi
fi

theme_name=$(theme_normalize_name "$theme_name")
if [[ ! "$theme_name" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  printf 'Invalid theme name: %s\n' "$theme_name" >&2
  exit 1
fi

destination="$HYPRKARL_PATH/user/themes/$theme_name"
if [[ -e "$theme_source" ]]; then
  source_directory="$theme_source"
  if [[ -f "$source_directory" ]]; then
    source_directory=$(dirname "$source_directory")
  fi
  if [[ "$source_directory/" == "$destination/"* ]]; then
    printf 'Theme source must live outside its generated destination: %s\n' "$destination" >&2
    exit 1
  fi
fi

(
  cd "$generator_path" || exit 1
  python -m theme_generator build "$theme_source" --output "$destination" --name "$theme_name"
) || exit 1

theme_validate_bundle "$destination"

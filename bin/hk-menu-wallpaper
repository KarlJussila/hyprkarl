#!/bin/bash
# hk-menu-wallpaper
# Open the shell-native wallpaper menu or run one of its focused actions.

case "${1:-}" in
select)
  hk-wallpaper set "$(hk-wallpaper select)"
  ;;
add)
  output_file=$(mktemp) || exit 1
  trap 'rm -f "$output_file"' EXIT
  hk-terminal-open -e bash -c 'hk-picture-select >"$1"' _ "$output_file"
  selected=$(<"$output_file")
  if [[ -n "$selected" ]]; then
    hk-wallpaper add "$selected"
  fi
  ;;
remove)
  hk-wallpaper remove "$(hk-wallpaper select '@urgent')"
  ;;
"")
  exec hk-shell menu open wallpaper
  ;;
*)
  echo "Usage: hk-menu-wallpaper [select|add|remove]" >&2
  exit 1
  ;;
esac

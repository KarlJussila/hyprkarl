#!/bin/bash
# hk-shell-menu
# Control the Quickshell menu. It opens on the output in HYPRKARL_OUTPUT (set
# by bar clicks, since the click crosses a process boundary), or the focused one.

action=${1:-toggle}
menu=${2:-main}

if [[ "$action" == "close" ]]; then
  exec qs -p "${XDG_CONFIG_HOME:-$HOME/.config}/quickshell" ipc call menu close
fi
exec qs -p "${XDG_CONFIG_HOME:-$HOME/.config}/quickshell" ipc call menu "$action" "${HYPRKARL_OUTPUT:-}" "$menu"

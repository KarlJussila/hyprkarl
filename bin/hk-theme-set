#!/bin/bash
# hk-theme-set
# Switch the active Hyprkarl theme and reload affected components.
#
# Usage:
#   hk-theme-set <theme-name>
#
# The theme name is case-insensitive and spaces are treated as hyphens,
# so "Forest Dark" and "forest-dark" are equivalent.

if [[ -z "$1" ]]; then
  echo "Usage: hk-theme-set <theme-name>" >&2
  exit 1
fi

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/lib/theme.sh"

THEME_NAME=$(theme_normalize_name "$@")

theme_apply_bundle "$THEME_NAME" || exit 1

post_action_status=0
theme_ensure_wallpaper_selection || post_action_status=1
hk-wallpaper-init --if-ready || post_action_status=1

hyprctl reload >/dev/null
hk-terminal-reload
hk-btop-reload || exit 1

hk-hook-run theme-set || post_action_status=1

if [[ "$post_action_status" -ne 0 ]]; then
  printf "Theme '%s' was applied, but a wallpaper action or lifecycle hook failed.\n" "$THEME_NAME" >&2
  exit 1
fi

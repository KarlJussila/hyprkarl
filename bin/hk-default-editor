#!/bin/bash
# hk-default-editor
# Installs an editor and sets it as the default ($EDITOR).
#
# Usage:
#   hk-default-editor <editor>
#
#   editor   One of: nvim, vim, nano, micro, vscodium

if (($# == 0)); then
  echo "Usage: hk-default-editor [nvim|vim|nano|micro|vscodium]"
  exit 1
fi

package="$1"
default_file="${XDG_CONFIG_HOME:-$HOME/.config}/uwsm/default"

case "$package" in
nvim | vim | nano | micro | vscodium) ;;
*)
  echo "Unknown editor: $package"
  exit 1
  ;;
esac

if hk-pkg install "$package"; then
  sed -i "s/^export EDITOR=.*/export EDITOR=$package/" "$default_file"
else
  echo "Failed to install $package"
fi

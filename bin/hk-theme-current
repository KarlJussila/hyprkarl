#!/bin/bash
# hk-theme-current
# Print the current theme name, formatted as "Title Case".

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/lib/theme.sh"

theme_name=$(theme_current_name)
if [[ -z "$theme_name" ]]; then
  echo "Unknown"
  exit 0
fi

printf '%s\n' "$theme_name" | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'

#!/bin/bash
# hk-shell-notifications
# Control shell-native notifications through the public IPC target.

method=${1:-}
case "$method" in
  dismiss-all) method=dismissAll ;;
  toggle-silenced) method=toggleSilenced ;;
esac

exec qs -p "${XDG_CONFIG_HOME:-$HOME/.config}/quickshell" ipc call notifications "$method"

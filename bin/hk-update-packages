#!/bin/bash
# hk-update-packages
# Review one-time removals and install newly required packages.

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/lib/update.sh"

PACKAGES_DIR="$HYPRKARL_PATH/packages"
PACKAGE_STATE_TOOL="$SCRIPT_DIR/lib/update_packages.py"

plan=$(python3 "$PACKAGE_STATE_TOOL" plan "$PACKAGES_DIR" "$UPDATE_PACKAGE_STATE") || exit 1
installed=$(pacman -Qq) || exit 1
unrequired=$(pacman -Qqt) || exit 1

# pacman refuses to remove a package another one needs, and one refusal fails
# the whole removal. Offer only packages nothing depends on; mark the rest as
# dependencies so pacman drops them once nothing needs them.
removal_rows=()
already_absent=()
still_needed=()
while IFS=$'\t' read -r package reason; do
  [[ -z "$package" ]] && continue
  if ! grep -Fxq "$package" <<<"$installed"; then
    already_absent+=("$package")
  elif ! grep -Fxq "$package" <<<"$unrequired"; then
    still_needed+=("$package")
  else
    removal_rows+=("$package — $reason"$'\t'"$package")
  fi
done < <(jq -r '.removals[] | [.package, .reason] | @tsv' <<<"$plan")

if [[ ${#still_needed[@]} -gt 0 ]]; then
  printf 'Kept because other packages need them: %s\n' "${still_needed[*]}"
  sudo pacman -D --asdeps "${still_needed[@]}" >/dev/null || exit 1
fi

selected_removals=()
if [[ ${#removal_rows[@]} -gt 0 ]]; then
  printf 'Packages Hyprkarl no longer requires:\n'
  selection=$(printf '%s\n' "${removal_rows[@]}" \
    | gum choose --no-limit --selected '*' --label-delimiter $'\t' \
        --header 'Uncheck anything you want to keep:')
  choice_status=$?
  if [[ "$choice_status" -ne 0 ]]; then
    printf 'Package update cancelled; no removal choices were recorded.\n'
    exit 1
  fi
  if [[ -n "$selection" ]]; then
    mapfile -t selected_removals <<<"$selection"
  fi
fi

if [[ ${#already_absent[@]} -gt 0 ]]; then
  printf 'Already absent: %s\n' "${already_absent[*]}"
fi

removal_status=0
if [[ ${#selected_removals[@]} -gt 0 ]]; then
  hk-pkg-remove "${selected_removals[@]}" || removal_status=1
fi

python3 "$PACKAGE_STATE_TOOL" record removalsReviewed \
  "$PACKAGES_DIR" "$UPDATE_PACKAGE_STATE" || exit 1

if [[ "$removal_status" -ne 0 ]]; then
  printf 'Some selected packages could not be removed. Retry manually with:\n' >&2
  printf '  hk-pkg remove %s\n' "${selected_removals[*]}" >&2
  printf 'This removal change was recorded and will not be presented again.\n' >&2
  exit 1
fi

installed=$(pacman -Qq) || exit 1

missing_pacman=()
while IFS= read -r package; do
  [[ -z "$package" ]] && continue
  grep -Fxq "$package" <<<"$installed" || missing_pacman+=("$package")
done < <(jq -r '.additions.pacman[]' <<<"$plan")

missing_aur=()
while IFS= read -r package; do
  [[ -z "$package" ]] && continue
  grep -Fxq "$package" <<<"$installed" || missing_aur+=("$package")
done < <(jq -r '.additions.aur[]' <<<"$plan")

# Installing from a stale package database fails once mirrors drop the old
# versions, and Arch does not support syncing without upgrading, so new
# packages come with a system upgrade.
if [[ ${#missing_pacman[@]} -gt 0 ]] || [[ ${#missing_aur[@]} -gt 0 ]]; then
  printf 'Upgrading the system and installing required packages: %s\n' \
    "${missing_pacman[*]}"
  sudo pacman -Syu --needed --noconfirm "${missing_pacman[@]}" || exit 1
fi
if [[ ${#missing_aur[@]} -gt 0 ]]; then
  printf 'Installing required AUR packages: %s\n' "${missing_aur[*]}"
  hk-pkg-install-aur "${missing_aur[@]}" || exit 1
fi

python3 "$PACKAGE_STATE_TOOL" record applied \
  "$PACKAGES_DIR" "$UPDATE_PACKAGE_STATE" || exit 1
printf 'Packages updated.\n'

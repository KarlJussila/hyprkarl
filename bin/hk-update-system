#!/bin/bash
# hk-update-system
# Run pending privileged system migrations once, in lexical order.

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/lib/update.sh"

MIGRATIONS_DIR="$HYPRKARL_PATH/system/migrations"

pending=()
for migration in "$MIGRATIONS_DIR"/*; do
  [[ -f "$migration" && -x "$migration" ]] || continue
  id=$(basename "$migration")
  [[ -e "$UPDATE_SYSTEM_MIGRATION_DIR/$id" ]] || pending+=("$migration")
done

if [[ ${#pending[@]} -eq 0 ]]; then
  printf 'System migrations are up to date.\n'
  exit 0
fi

printf 'Pending system migrations:\n'
for migration in "${pending[@]}"; do
  printf '  %s\n' "$(basename "$migration")"
done
if ! gum confirm 'Run these migrations? Administrator access will be requested.'; then
  printf 'System migration cancelled.\n'
  exit 1
fi

sudo -v || exit 1
mkdir -p "$UPDATE_SYSTEM_MIGRATION_DIR" || exit 1
for migration in "${pending[@]}"; do
  id=$(basename "$migration")
  printf 'Running %s...\n' "$id"
  HYPRKARL_PATH="$HYPRKARL_PATH" "$migration" || exit 1
  : > "$UPDATE_SYSTEM_MIGRATION_DIR/$id" || exit 1
done

printf 'System migrations complete.\n'

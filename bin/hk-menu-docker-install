#!/bin/bash
# hk-menu-docker-install
# Open or populate the shell-native Docker install menu.

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/lib/docker.sh"

if [[ "${1:-}" == "--entries" ]]; then
  docker_menu_entries missing install
  exit
fi

exec hk-shell menu open docker-install

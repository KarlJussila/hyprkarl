#!/bin/bash
# hk-update-apply
# Bring this machine to the reviewed source revision: packages, migrations,
# starting configs, shipped links, theme, and reloads. With nothing reviewed,
# reapply the current checkout.

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/lib/update.sh"
source "$SCRIPT_DIR/lib/shell.sh"

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

pending=$(update_read_pending_source)
head=$(update_head_commit)

if ! git -C "$HYPRKARL_PATH" diff --quiet \
    || ! git -C "$HYPRKARL_PATH" diff --cached --quiet; then
  fail "Tracked files in the Hyprkarl checkout have local changes. Commit or restore them first."
fi

if [[ -n "$pending" ]] && [[ "$pending" != "$head" ]]; then
  branch=$(git -C "$HYPRKARL_PATH" branch --show-current)
  source_branch=$(update_source_branch)
  if [[ "$branch" != "$source_branch" ]]; then
    fail "The reviewed update targets '$source_branch', but this checkout is on '$branch'. Merge it manually on this custom branch."
  fi
  if ! update_commit_valid "$pending"; then
    fail "The reviewed source revision is no longer available. Run hk-update sync again."
  fi
  if ! git -C "$HYPRKARL_PATH" merge-base --is-ancestor HEAD "$pending"; then
    fail "The checkout and reviewed source have diverged. Merge the source manually."
  fi
fi

# The shell runs from this checkout, so stop it while files change and start
# it again however apply ends.
if hk_shell_is_running; then
  hk-shell stop || exit 1
  trap 'hk-shell start' EXIT
fi

if [[ -n "$pending" ]] && [[ "$pending" != "$head" ]]; then
  git -C "$HYPRKARL_PATH" merge --ff-only "$pending" \
    || fail "Could not fast-forward to the reviewed source revision."
fi

# Packages first: a migration may configure a package this revision adds.
hk-update-packages || fail "Package changes did not complete."

mapfile -t migrations < <(update_pending_migrations)
for migration in "${migrations[@]}"; do
  printf 'Running migration %s...\n' "${migration##*/}"
  "$migration" || fail "Migration ${migration##*/} failed; fix it and run hk-update apply again."
  mkdir -p "$UPDATE_MIGRATION_DIR" && : > "$UPDATE_MIGRATION_DIR/${migration##*/}"
done

hk-config-seed || fail "Could not create starting configuration."

conflicts=$(check_config_conflicts)
if [[ -n "$conflicts" ]]; then
  printf 'These paths block Hyprkarl links:\n%s\n' "$conflicts" >&2
  fail "Move or rename them, then run hk-update apply again."
fi

printf 'Rebuilding the selected theme...\n'
theme_name=$(theme_current_name)
theme_activate "${theme_name:-hyprkarl}" || fail "Could not rebuild the selected theme."

printf 'Restowing shipped configuration...\n'
stow_restow_config || fail "Could not restow shipped configuration."
remove_stale_symlinks
link_agent_skills || fail "Could not link Hyprkarl's agent skill."

theme_ensure_wallpaper_selection || fail "Could not restore the wallpaper selection."
hk-wallpaper-init --if-ready || fail "Could not restore the live wallpaper."
if pgrep -x Hyprland >/dev/null; then
  hyprctl reload >/dev/null || fail "Hyprland could not reload the applied configuration."
  theme_apply_cursor || fail "Could not apply the theme's cursor."
fi
hk-terminal-reload || fail "Terminal configuration reload failed."
hk-btop-reload || fail "Btop configuration reload failed."

update_write_configuration_revision || fail "Could not record the applied revision."
update_clear_pending_source
printf 'Configuration applied.\n'

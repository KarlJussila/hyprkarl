#!/usr/bin/env python3
"""Revert a pending display-layout trial."""

import sys

from lib.display import revert_layout


def main() -> int:
    if len(sys.argv) != 2:
        print("Usage: hk-display-revert <token>", file=sys.stderr)
        return 1
    try:
        revert_layout(sys.argv[1])
        return 0
    except Exception as error:
        print(f"Could not revert display layout: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())

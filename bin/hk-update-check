#!/bin/bash
# hk-update-check
# Report pending source, configuration, package, and system work. Read-only.

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/lib/update.sh"

PACKAGES_DIR="$HYPRKARL_PATH/packages"
PACKAGE_STATE_TOOL="$SCRIPT_DIR/lib/update_packages.py"

printf '=== Source ===\n'
pending=$(update_read_pending_source)
if [[ -n "$pending" ]]; then
  printf '  Reviewed revision ready to apply: %.12s\n' "$pending"
else
  printf '  No reviewed source revision is pending. Run hk-update sync to fetch and review.\n'
fi

printf '\n=== Configuration ===\n'
configuration=$(update_read_configuration_revision)
if [[ -z "$configuration" ]] && [[ -f "$LEGACY_UPDATE_STATE_DIR/dotfiles.commit" ]]; then
  configuration=$(<"$LEGACY_UPDATE_STATE_DIR/dotfiles.commit")
fi
head=$(update_head_commit)
if [[ "$configuration" == "$head" ]] && [[ -z "$pending" ]]; then
  printf '  Applied at current HEAD.\n'
elif [[ -z "$configuration" ]]; then
  printf '  No successful configuration application is recorded.\n'
else
  printf '  Last applied revision: %.12s\n' "$configuration"
  printf '  Current checkout:      %.12s\n' "$head"
fi
conflicts=$(check_config_conflicts)
if [[ -n "$conflicts" ]]; then
  printf '  Unmanaged paths blocking configuration application:\n'
  printf '%s\n' "$conflicts" | sed 's/^/    /'
fi
if ! theme_gtk_install_is_replaceable; then
  printf '  Unmanaged GTK theme target: %s\n' "$HYPRKARL_GTK_THEME_HOME"
fi

printf '\n=== Packages ===\n'
package_state="$UPDATE_PACKAGE_STATE"
temporary_state=""
if [[ ! -f "$package_state" ]] && [[ -f "$LEGACY_UPDATE_STATE_DIR/packages.commit" ]]; then
  legacy_revision=$(<"$LEGACY_UPDATE_STATE_DIR/packages.commit")
  if update_commit_valid "$legacy_revision"; then
    temporary_dir=$(mktemp -d) || exit 1
    temporary_state="$temporary_dir/packages.json"
    python3 "$PACKAGE_STATE_TOOL" import-legacy \
      "$HYPRKARL_PATH" "$legacy_revision" "$temporary_state" || exit 1
    package_state="$temporary_state"
  fi
fi
plan=$(python3 "$PACKAGE_STATE_TOOL" plan "$PACKAGES_DIR" "$package_state") || exit 1
declared_pacman=$(jq -r '.additions.pacman[]' <<<"$plan")
declared_aur=$(jq -r '.additions.aur[]' <<<"$plan")
removals=$(jq -r '.removals[] | "\(.package) — \(.reason)"' <<<"$plan")
installed=$(pacman -Qq) || exit 1
pacman_additions=""
while IFS= read -r package; do
  [[ -z "$package" ]] && continue
  grep -Fxq "$package" <<<"$installed" || pacman_additions+="${package}"$'\n'
done <<<"$declared_pacman"
aur_additions=""
while IFS= read -r package; do
  [[ -z "$package" ]] && continue
  grep -Fxq "$package" <<<"$installed" || aur_additions+="${package}"$'\n'
done <<<"$declared_aur"
pacman_additions=${pacman_additions%$'\n'}
aur_additions=${aur_additions%$'\n'}
if [[ -n "$pacman_additions" ]]; then
  printf '  New required packages:\n%s\n' "$(sed 's/^/    /' <<<"$pacman_additions")"
fi
if [[ -n "$aur_additions" ]]; then
  printf '  New required AUR packages:\n%s\n' "$(sed 's/^/    /' <<<"$aur_additions")"
fi
if [[ -n "$removals" ]]; then
  printf '  Package removals awaiting one-time review:\n%s\n' "$(sed 's/^/    /' <<<"$removals")"
fi
if [[ -z "$pacman_additions$aur_additions$removals" ]] \
    && [[ -n "$declared_pacman$declared_aur" ]]; then
  printf '  Package snapshot needs recording; all newly declared packages are installed.\n'
elif [[ -z "$pacman_additions$aur_additions$removals" ]]; then
  printf '  Package declarations are up to date.\n'
fi
if [[ -n "$temporary_state" ]]; then
  rm -rf "$(dirname "$temporary_state")"
fi

printf '\n=== System ===\n'
legacy_system=0
[[ -f "$LEGACY_UPDATE_STATE_DIR/system.commit" ]] && legacy_system=1
system_pending=0
for migration in "$HYPRKARL_PATH/system/migrations"/*; do
  [[ -f "$migration" && -x "$migration" ]] || continue
  id=$(basename "$migration")
  if [[ -e "$UPDATE_SYSTEM_MIGRATION_DIR/$id" ]]; then
    continue
  fi
  if [[ "$legacy_system" -eq 1 ]] \
      && [[ " ${UPDATE_LEGACY_SYSTEM_MIGRATIONS[*]} " == *" $id "* ]]; then
    continue
  fi
  printf '  %s\n' "$id"
  system_pending=1
done
[[ "$system_pending" -eq 0 ]] && printf '  System migrations are up to date.\n'

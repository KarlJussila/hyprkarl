#!/usr/bin/env python3
"""Print installed theme actions for a dynamic Quickshell menu."""

from __future__ import annotations

import json
import os
import shlex
import sys
from pathlib import Path


def main() -> int:
    themes_path = Path(os.environ["HYPRKARL_PATH"]) / "themes"
    themes = sorted(path.name for path in themes_path.iterdir() if path.is_dir())
    entries = [
        {
            "id": f"theme.{theme}",
            "label": theme.replace("-", " ").title(),
            "action": {
                "type": "command",
                "command": f"hk-theme set {shlex.quote(theme)}",
            },
        }
        for theme in themes
    ]
    json.dump(entries, sys.stdout, ensure_ascii=False, separators=(",", ":"))
    print()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

#!/bin/bash
# hk-screenshot
# Capture the desktop. Freezing the screen keeps an open panel in the shot.

mode=${1:-}
case "$mode" in
  window | output | region) shift ;;
  *) echo "Usage: hk-screenshot <window|output|region> [hyprshot options]" >&2; exit 1 ;;
esac

exec hyprshot --freeze -m "$mode" "$@"

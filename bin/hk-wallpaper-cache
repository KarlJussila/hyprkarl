#!/bin/bash
# hk-wallpaper-cache
# Manage the wallpaper preview cache for the current theme.
#
# Usage:
#   hk-wallpaper-cache                          Sync cache (add missing, remove stale)
#   hk-wallpaper-cache --regenerate             Wipe and regenerate entire cache
#   hk-wallpaper-cache --single <filename>      Regenerate one thumbnail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/lib/theme.sh"

THEME_NAME=$(theme_current_name)
WALLPAPER_DIR="$HYPRKARL_CURRENT_THEME/wallpapers"
CACHE_DIR="$HOME/.cache/hyprkarl/wallpapers/$THEME_NAME"
PREVIEW_SIZE="960x540"
FORMAT_FILE="$CACHE_DIR/.format"

mkdir -p "$CACHE_DIR"

if [[ ! -f "$FORMAT_FILE" ]] || [[ $(< "$FORMAT_FILE") != "$PREVIEW_SIZE" ]]; then
  rm -f "$CACHE_DIR"/*
  printf '%s\n' "$PREVIEW_SIZE" > "$FORMAT_FILE"
fi

generate_preview() {
  local img="$1"
  local name
  name=$(basename "$img")
  magick "$img" -strip -thumbnail "${PREVIEW_SIZE}^" \
    -gravity center -extent "$PREVIEW_SIZE" "$CACHE_DIR/$name"
}

if [[ "$1" == "--regenerate" ]]; then
  rm -f "$CACHE_DIR"/*
  for img in "$WALLPAPER_DIR"/*; do
    [[ -f "$img" ]] || continue
    generate_preview "$img"
  done
  exit 0
fi

if [[ "$1" == "--single" ]]; then
  if [[ -z "$2" ]]; then
    echo "Usage: hk-wallpaper-cache --single <filename>" >&2
    exit 1
  fi
  rm -f "$CACHE_DIR/$2"
  generate_preview "$WALLPAPER_DIR/$2"
  exit 0
fi

# Sync mode: remove stale thumbs, add missing.
for cached in "$CACHE_DIR"/*; do
  [[ -f "$cached" ]] || continue
  name=$(basename "$cached")
  if [[ ! -f "$WALLPAPER_DIR/$name" ]]; then
    rm "$cached"
  fi
done

for img in "$WALLPAPER_DIR"/*; do
  [[ -f "$img" ]] || continue
  name=$(basename "$img")
  if [[ ! -f "$CACHE_DIR/$name" ]]; then
    generate_preview "$img"
  fi
done

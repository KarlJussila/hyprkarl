#!/usr/bin/env python3
"""Download and regenerate provider-ready Nerd Font menu data."""

from __future__ import annotations

import csv
import io
import json
import os
import shlex
import subprocess
import tempfile
from pathlib import Path
from urllib.request import urlopen

CSV_URL = (
    "https://raw.githubusercontent.com/8bitmcu/NerdFont-Cheat-Sheet/master/nerdfont.csv"
)


def log(level: str, message: str) -> None:
    subprocess.run(["gum", "log", "--level", level, message], check=False)


def download_entries() -> list[dict]:
    with urlopen(CSV_URL) as response:
        rows = csv.reader(io.TextIOWrapper(response, encoding="utf-8"))
        entries = []
        for row in rows:
            if len(row) < 2 or not row[1].strip():
                continue
            try:
                icon = chr(int(row[1].strip(), 16))
            except ValueError:
                continue
            name = row[0]
            entries.append(
                {
                    "id": f"icon.{name}",
                    "icon": icon,
                    "label": name,
                    "action": {
                        "type": "command",
                        "command": f"hk-icon-copy {shlex.quote(icon)}",
                    },
                }
            )
    return entries


def main() -> int:
    data_home = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
    icon_data = data_home / "hyprkarl/data/nerdfont-menu.json"
    log("info", "Downloading Nerd Font glyph data...")

    try:
        entries = download_entries()
    except OSError as error:
        log("error", f"Could not download Nerd Font glyph data: {error}")
        return 1
    if not entries:
        log("error", "Downloaded icon menu data is empty or invalid")
        return 1

    icon_data.parent.mkdir(parents=True, exist_ok=True)
    temporary_path = None
    try:
        with tempfile.NamedTemporaryFile(
            "w",
            encoding="utf-8",
            dir=icon_data.parent,
            prefix=icon_data.name + ".tmp.",
            delete=False,
        ) as temporary:
            temporary_path = Path(temporary.name)
            json.dump(entries, temporary, ensure_ascii=False, separators=(",", ":"))
        temporary_path.replace(icon_data)
    except OSError as error:
        if temporary_path is not None:
            temporary_path.unlink(missing_ok=True)
        log("error", f"Could not save Nerd Font glyph data: {error}")
        return 1

    log("info", f"Saved {len(entries)} icons to {icon_data}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

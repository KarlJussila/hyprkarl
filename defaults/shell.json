{
  "modules": {
    "bar": true,
    "panels": true,
    "notifications": true,
    "osd": true,
    "polkit": true,
    "menu": true,
    "applications": true,
    "calculator": true,
    "wallpaper": true
  },
  "osd": {
    "edge": "bottom",
    "margin": 40,
    "timeout": 2000,
    "mediaTimeout": 3000
  },
  "notifications": {
    "edge": "bar",
    "side": "right",
    "gap": 0,
    "sideMargin": 0,
    "defaultTimeout": 5000,
    "statusTimeout": 2000,
    "maxVisible": 5,
    "fallbackIcon": {
      "kind": "none"
    },
    "criticalIcon": {
      "kind": "none"
    },
    "ignoredApplications": [
      "spotify"
    ],
    "compactApplications": [
      "battery"
    ],
    "iconOverrides": {
      "battery": {
        "kind": "component",
        "source": "builtin/BatteryIcon.qml"
      }
    }
  },
  "applications": {
    "hidden": [
      "avahi-discover",
      "bssh",
      "bvnc",
      "footclient",
      "foot-server",
      "octopi-cachecleaner",
      "octopi-notifier",
      "octopi-repoeditor",
      "qv4l2",
      "qvidcap",
      "uuctl",
      "vscodium-wayland",
      "xgps",
      "xgpsspeed"
    ]
  },
  "bar": {
    "edge": "top",
    "exclusive": true,
    "layout": {
      "start": [
        {
          "id": "menu",
          "kind": "command",
          "icon": "",
          "tooltip": "Main menu",
          "primaryCommand": "hk-shell menu toggle main"
        },
        {
          "id": "workspaces",
          "kind": "workspaces",
          "alwaysShow": [1],
          "includeFocused": true,
          "includeOccupied": true
        },
        {
          "id": "cpu",
          "kind": "cpu",
          "format": "{temp}°",
          "alternateFormat": "{temp}° | {usage}%"
        },
        {
          "id": "gpu",
          "kind": "gpu",
          "format": "{usage}%",
          "alternateFormat": "{usage}% | {vramUsed}/{vramTotal}"
        },
        {
          "id": "ram",
          "kind": "ram",
          "icon": "",
          "format": "{usedPercent}%",
          "alternateFormat": "{used}/{total} | {swapUsed}/{swapTotal}"
        },
        {
          "id": "tray",
          "kind": "tray",
          "direction": "end"
        }
      ],
      "center": {
        "before": [
          {
            "id": "recording",
            "kind": "recording",
            "icon": "󰻂",
            "primaryCommand": "hk-screen-record --stop-recording"
          }
        ],
        "anchor": {
          "id": "clock",
          "kind": "clock",
          "format": "ddd h:mm AP",
          "alternateFormat": "ddd h:mm:ss AP"
        },
        "after": [
          {
            "id": "caffeine",
            "kind": "toggle",
            "onCommand": "hk-caffeine on",
            "offCommand": "hk-caffeine off",
            "syncCommand": "hk-caffeine status",
            "onIcon": "",
            "offIcon": "󰽖",
            "switch": {
              "variant": "mark"
            }
          },
          {
            "id": "update",
            "kind": "command",
            "command": "hk-update-available",
            "interval": 3600000,
            "output": "json",
            "icon": "󰚰",
            "tooltip": "Hyprkarl update available",
            "primaryCommand": "hk-tui-launch hk-update all"
          }
        ]
      },
      "end": [
        {
          "id": "display",
          "kind": "display"
        },
        {
          "id": "audio",
          "kind": "audio",
          "showPercentage": false,
          "secondaryCommand": "hk-audio-launch"
        },
        {
          "id": "bluetooth",
          "kind": "bluetooth",
          "secondaryCommand": "hk-bluetooth-launch"
        },
        {
          "id": "network",
          "kind": "network",
          "secondaryCommand": "hk-wifi-launch"
        },
        {
          "id": "battery",
          "kind": "battery",
          "showPercentage": true,
          "lowThreshold": 0.15,
          "secondaryCommand": "hk-shell menu toggle power"
        }
      ]
    }
  },
  "userRoot": {
    "source": "",
    "settings": {}
  }
}

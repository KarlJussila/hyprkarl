#!/bin/bash
# hk-shell-menu
# Control the Quickshell menu through its public IPC target.

action=${1:-toggle}
menu=${2:-main}

if [[ "$action" == "close" ]]; then
  exec qs -p "$HYPRKARL_PATH/config/quickshell" ipc call menu close
fi

# A bar click crosses a process boundary here, so forward the bar that launched it.
if [[ -n ${HYPRKARL_OUTPUT:-} ]]; then
  exec qs -p "$HYPRKARL_PATH/config/quickshell" ipc call menu "${action}ForScreen" "$HYPRKARL_OUTPUT" "$menu"
fi

exec qs -p "$HYPRKARL_PATH/config/quickshell" ipc call menu "$action" "$menu"

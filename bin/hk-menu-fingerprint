#!/bin/bash
# hk-menu-fingerprint
# Open the shell-native fingerprint menu appropriate to current setup state.

# Check if fingerprint auth is set up
is_setup() {
  command -v fprintd-list &>/dev/null && grep -q pam_fprintd.so /etc/pam.d/sudo 2>/dev/null
}

if is_setup; then
  exec hk-shell menu open fingerprint
else
  exec hk-shell menu open fingerprint-setup
fi

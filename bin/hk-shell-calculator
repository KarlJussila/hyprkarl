#!/bin/bash
# hk-shell-calculator
# Control the shell-native calculator. It opens on the output in
# HYPRKARL_OUTPUT (set by bar clicks), or the focused one.

action=${1:-toggle}
if [[ "$action" == "close" ]]; then
  exec qs -p "${XDG_CONFIG_HOME:-$HOME/.config}/quickshell" ipc call calculator close
fi
exec qs -p "${XDG_CONFIG_HOME:-$HOME/.config}/quickshell" ipc call calculator "$action" "${HYPRKARL_OUTPUT:-}"

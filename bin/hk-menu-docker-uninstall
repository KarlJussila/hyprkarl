#!/bin/bash
# hk-menu-docker-uninstall
# Open or populate the shell-native Docker uninstall menu.

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/lib/docker.sh"

if [[ "${1:-}" == "--entries" ]]; then
  docker_menu_entries installed uninstall
  exit
fi

exec hk-shell menu open docker-uninstall

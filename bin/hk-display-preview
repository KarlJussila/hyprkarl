#!/usr/bin/env python3
"""Apply a complete display layout as a time-limited trial."""

import json
import sys

from lib.display import preview_layout


def main() -> int:
    if len(sys.argv) != 2:
        print("Usage: hk-display-preview <layout-json>", file=sys.stderr)
        return 1
    try:
        layout = json.loads(sys.argv[1])
        if not isinstance(layout, dict):
            raise RuntimeError("Layout must be a JSON object")
        json.dump(preview_layout(layout), sys.stdout, separators=(",", ":"))
        print()
        return 0
    except Exception as error:
        print(f"Could not preview display layout: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
